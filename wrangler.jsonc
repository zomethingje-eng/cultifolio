{
  // Cultifolio on Cloudflare Workers. Create the R2 bucket and KV namespace once (see README) and
  // paste the KV id below; everything else here works as-is with `wrangler dev`.
  "name": "cultifolio",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": { "DOSSIER_V": "1", "SYNC_OPEN": "1" },
  // R2 holds dossiers (s/v1/<gbifKey>.json), climate cells, and later encrypted photos.
  // Create it once:  npx wrangler r2 bucket create cultifolio
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "cultifolio" }],
  // KV holds only queues and small counters.
  // Create it once:  npx wrangler kv namespace create QUEUE   (then paste the id below)
  "kv_namespaces": [{ "binding": "QUEUE", "id": "PASTE_KV_ID_HERE" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
