{
	// Cultifolio on Cloudflare Workers. Create the R2 bucket and KV namespace once (see README) and
	// paste the KV id below; everything else here works as-is with `wrangler dev`.
	"name": "cultifolio",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// SYNC_OPEN must be exactly "1" for any vault to sync without a licence; unset or anything else closes it.
	"vars": {
		"SYNC_OPEN": "1"
	},
	// R2 holds the corpus (s/v<N>/<gbifKey>.json and index.json; N is DOSSIER_V in src/lib/dossier/schema.ts) and the
	// encrypted sync vaults (vault/<id>/...). The corpus is uploaded with rclone, see docs/DEPLOY.md; static/.assetsignore
	// keeps static/s out of the Worker's assets so the only copy the site serves is R2's.
	// Create it once:  npx wrangler r2 bucket create cultifolio
	"r2_buckets": [
		{
			"binding": "STORE",
			"bucket_name": "cultifolio"
		}
	],
	// KV holds only small counters: per-vault and per-address bytes, vaults per address per day, the rate limit
	// (keys listed at the top of src/lib/server/sync.ts). The binding is load-bearing: without it the Worker
	// refuses every vault creation (it fails closed) and the rate limit counts in memory alone.
	// Create it once:  npx wrangler kv namespace create QUEUE   (then paste the id below)
	"kv_namespaces": [
		{
			"binding": "QUEUE",
			"id": "1eb90f57004b4613b2f5f91202435c42"
		}
	]
}